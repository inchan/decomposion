{
  "name": "Decomposion experiment lab (no automatic LLM calls)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python3 scripts/bootstrap_lab.py",
  "customizations": {
    "vscode": {
      "settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"}
    }
  },
  "remoteUser": "vscode"
}
